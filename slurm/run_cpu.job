#!/bin/bash
# Stage 1 (CPU): each array task runs COUNT manifest lines with WORKERS parallel
# single-threaded processes. On rome the smallest allocation is 16 cores, so use them.
#SBATCH --job-name=srl-cpu
#SBATCH --partition=rome
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=08:00:00
source "$SLURM_SUBMIT_DIR/slurm/env.sh"
MANIFEST=$1; COUNT=$2; WORKERS=${3:-16}
python -m experiments.run --manifest "$MANIFEST" --count "$COUNT" \
    --chunk "$SLURM_ARRAY_TASK_ID" --workers "$WORKERS" --threads 1 --device cpu
